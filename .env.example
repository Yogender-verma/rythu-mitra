# ==================================================
# RYTHUMITRA AI — GLOBAL ENVIRONMENT CONFIGURATION
# ==================================================

# --------------------------------------------------
# FRONTEND: FIREBASE WEB SDK CONFIGURATION
# (Obtain these from Firebase Console -> Project Settings -> General -> Your Apps -> Web App)
# --------------------------------------------------
VITE_FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --------------------------------------------------
# BACKEND: FASTAPI CONFIGURATION
# --------------------------------------------------
PROJECT_NAME="RythuMitra AI"
SECRET_KEY=rythumitra-super-secret-key-change-in-production
DATABASE_URL=sqlite:///./rythumitra.db

# Optional: Path to Firebase Admin SDK Service Account JSON Key (if using custom credentials)
# FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json
